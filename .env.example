# Copy to .env and fill in values. Never commit .env.

# --- FalkorDB (Gate 0: local Docker needs no password) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=lineage

# --- LLM (Gate 2) ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high. Thought tokens count toward MAX_TOKENS_PER_CALL.
LLM_THINKING_LEVEL=minimal
GEMINI_API_KEY=

# Optional LLM-only fallback. Leave LLM_FALLBACK_PROVIDER empty to disable.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
GROQ_API_KEY=

# --- Embeddings (Gate 1). One model for seed AND runtime. ---
# Changing the model or dimension requires re-embedding and rebuilding the vector index.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Leave empty to reuse GEMINI_API_KEY.
EMBEDDING_API_KEY=

# --- Budget limits ---
MAX_LLM_CALLS_PER_RUN=3
MAX_LLM_CALLS_PER_DAY=200
MAX_TOKENS_PER_CALL=1024
MAX_REQUESTS_PER_MINUTE=8

# --- Verdict propagation (section 5 of the brief) ---
PROPAGATION_DECAY=0.9
PROPAGATION_THRESHOLD=0.4
PROPAGATION_MAX_DEPTH=6

# --- Mode: "local" (free text, needs your own key) or "recorded" (public deploy, presets only) ---
LINEAGE_MODE=local
